rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function memberPath(fid){ return /databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid); }
    function member(fid){ return signedIn() && exists(memberPath(fid)); }
    function permission(fid){ return get(memberPath(fid)).data.permission; }
    function admin(fid){ return member(fid) && permission(fid) in ['owner','admin']; }
    function editor(fid){ return member(fid) && permission(fid) in ['owner','admin','editor']; }
    function willBeMember(fid){ return signedIn() && existsAfter(memberPath(fid)); }

    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    match /families/{fid} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if member(fid);
      allow update: if editor(fid) || (willBeMember(fid) && request.auth.uid == resource.data.ownerUid);
      allow delete: if false;
      match /members/{uid} {
        allow read: if member(fid);
        allow create: if signedIn() && (request.auth.uid == uid || admin(fid));
        allow update, delete: if admin(fid);
      }
      match /data/{docId} { allow read: if member(fid); allow write: if editor(fid); }
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create: if signedIn() && admin(request.resource.data.familyId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (admin(resource.data.familyId) || (!resource.data.keys().hasAny(['usedBy']) && request.resource.data.usedBy == request.auth.uid));
      allow delete: if signedIn() && admin(resource.data.familyId);
    }
  }
}